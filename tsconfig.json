{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "esModuleInterop": true,
    "allowJs": true,
    "skipLibCheck": true,
    "declaration": true,
    "noEmit": true,
    "types": ["node"],
    "noUncheckedIndexedAccess": true
  },
  "include": ["src", "tests", "vitest.config.ts"]
}
